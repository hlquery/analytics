# hlquery analytics (Express + Sequelize)

# Server
HOST=0.0.0.0
PORT=8090
LOG_LEVEL=info

# Optional auth for ingestion endpoints (set this if you set analytics.api_token in hlquery)
ANALYTICS_API_TOKEN=change-me

# Database (choose ONE approach)
#
# 1) DATABASE_URL (preferred)
# DATABASE_URL=mysql://user:pass@127.0.0.1:3306/hlquery_analytics
#
# 2) Individual pieces
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hlquery_analytics
DB_USER=root
DB_PASSWORD=

# Optional: enable "force refresh" by calling hlquery's /modules/analytics/flush
HLQUERY_URL=http://127.0.0.1:9200
# If hlquery requires auth, set its API token here
HLQUERY_API_TOKEN=

# Dashboard auth
# When AUTOLOGIN=1, the UI/API skip login entirely and admin user management is disabled.
AUTOLOGIN=0
# Used to sign the login cookie (set to a long random string)
ANALYTICS_SESSION_SECRET=change-me-too
